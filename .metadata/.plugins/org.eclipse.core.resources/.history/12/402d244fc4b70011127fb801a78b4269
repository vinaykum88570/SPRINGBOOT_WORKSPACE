    // Get all trains
    public List<Train> getAllTrains() {
    	List<Train> allTrains = trainRepository.findAll();
    	for (Train train : allTrains) {
			System.out.println(train.toString());
		}
    	return allTrains;
    }

    // Get train by ID
    public Train getTrainById(Integer id) {
        return trainRepository.findById(id).get();
    }

    // Update Train
    public Train updateTrain(Integer id, Train train) {

        Train existingTrain = trainRepository.findById(id).orElse(null);

        if (existingTrain != null) {

            existingTrain.setTrainName(train.getTrainName());
            existingTrain.setTrainNumber(train.getTrainNumber());
            existingTrain.setSource(train.getSource());
            existingTrain.setDestination(train.getDestination());
            existingTrain.setTotal_Seats(train.getTotal_Seats());
            existingTrain.setAvailable_Seats(train.getAvailable_Seats());

            return trainRepository.save(existingTrain);
        }

        return null;
    }

    // Delete Train
    public void deleteTrain(Integer id) {
        trainRepository.deleteById(id);
    }
    
    
